{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting"
  ],
  "description": "Dependency bumps as pull requests with CI run, merged by hand (CLAUDE.md). Security fixes come at once; everything else waits two weeks and comes on Monday mornings, grouped.",
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 7am on monday"
  ],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "automerge": false,
  "semanticCommits": "disabled",
  "commitMessagePrefix": "Dependencies:",
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 7am on the first day of the month"
    ]
  },
  "packageRules": [
    {
      "description": "Next.js and its ESLint config move together.",
      "matchPackageNames": [
        "next",
        "eslint-config-next",
        "@next/**"
      ],
      "groupName": "Next.js"
    },
    {
      "description": "Minor and patch bumps of everything else in one pull request a week.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "matchPackageNames": [
        "!next",
        "!eslint-config-next",
        "!@next/**"
      ],
      "groupName": "minor and patch"
    },
    {
      "description": "The Node major follows .nvmrc and the Dockerfile together, by hand.",
      "matchDepNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
