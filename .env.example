# Copy this file to .env next to compose.yaml. Every setting is optional and shown with its default:
# an unchanged copy runs notefeed as the image ships it. With none set, anyone who can reach notefeed
# can read and post to any feed whose name they know. See docs/self-hosting/configuration.md.

# Absolute URL readers use to reach notefeed. Set it on a public instance: otherwise links
# in the RSS and API responses follow the Host header the client sends.
# PUBLIC_URL=https://notes.example.com

# Lock the instance: posting needs `Authorization: Bearer <password>`, the web UI a login.
# Read links keep working without it. E.g. `openssl rand -hex 32`.
# NOTEFEED_PASSWORD=

# Behind a reverse proxy: rate-limit per client IP from X-Forwarded-For. The proxy must
# overwrite that header, not append to it. Without this, all clients share one limit.
# NOTEFEED_TRUST_PROXY=1

# Posts (and failed password attempts) per client per minute. 0 turns the limit off.
# NOTEFEED_RATE_LIMIT=60

# Caps; 0 or unset means no limit. Over a cap, posting answers 507.
# NOTEFEED_MAX_FEEDS=100
# NOTEFEED_RESERVED_FEEDS=news,jobs
# NOTEFEED_RESERVED_PASSWORD=change-me-please
# NOTEFEED_FOOTER_FEEDS=news
# NOTEFEED_MAX_NOTES_PER_FEED=1000

# Uploaded images: bytes per image as sent (default and at most 10485760 = 10 MiB; over it, upload answers 413;
# every image is stored shrunk to 2560 px and without metadata) and images per feed (0 or unset: no limit; over it, upload answers 507).
# NOTEFEED_MAX_IMAGE_BYTES=10485760
# NOTEFEED_MAX_IMAGES_PER_FEED=0

# How long reading a text posted with pictures may take, in ms; it runs in a worker thread, so only the sender waits.
# NOTEFEED_PARSE_TIMEOUT_MS=10000

# 0 refuses every image with 403 (images_off); stored images keep being served.
# NOTEFEED_IMAGE_UPLOADS=1

# 0 leaves only random read ids: a chosen one is refused.
# NOTEFEED_ALLOW_CUSTOM_IDS=1

# Secret behind the read links. Unset: a random one kept in DATA_DIR/.secret.
# Changing it (or deleting .secret) changes every read link.
# NOTEFEED_SECRET=

# Your own imprint and privacy page: a Markdown file each, shown at /imprint and /privacy and linked from the
# footer. notefeed ships neither text; without a file there is no such page. See docs/self-hosting/legal-pages.md.
# NOTEFEED_IMPRINT_FILE=/data/imprint.md
# NOTEFEED_PRIVACY_FILE=/data/privacy.md

# Your own notice on the start page, a red warning banner above the introduction: a Markdown file. Without one there is no notice.
# NOTEFEED_NOTICE_FILE=/data/notice.md

# An address for a "Support" link (mailto:) in every footer. Unset: no link.
# NOTEFEED_SUPPORT_EMAIL=support@example.com

# Your own terms, a Markdown file shown at /terms and linked from the footer, like the imprint above.
# NOTEFEED_TERMS_FILE=/data/terms.md

# A "Report" link on every published note: a URL template with {read_id}, {note_id} and {file} filled in.
# Unset with an endpoint set (next), the link opens the built-in /report page; with neither, there is no link.
# NOTEFEED_REPORT_URL=https://report.example.com/?r={read_id}&n={note_id}&f={file}
# Where the built-in /report page sends a report: a form endpoint of an inbox. Unset: there is no such page.
# NOTEFEED_REPORT_ENDPOINT=

# Where feeds and notes are kept: fs (files in DATA_DIR, the default), sqlite or postgres.
# sqlite and postgres need NOTEFEED_SECRET (above) and, for postgres, the URL. See docs/self-hosting/storage.md.
# NOTEFEED_STORAGE=fs
# NOTEFEED_DATABASE_URL=postgres://notefeed:change-me@db:5432/notefeed

# Where a database backend keeps the bytes of image notes: db (in the database, the default), fs (a folder) or
# s3 (any S3-compatible object store; there is no default endpoint). See docs/self-hosting/storage.md.
# NOTEFEED_IMAGES=db
# NOTEFEED_IMAGES_DIR=/data/images
# NOTEFEED_S3_ENDPOINT=https://s3.example.com
# NOTEFEED_S3_BUCKET=notefeed-images
# NOTEFEED_S3_REGION=us-east-1
# NOTEFEED_S3_ACCESS_KEY=
# NOTEFEED_S3_SECRET_KEY=
# Turns on the operator's endpoint that reports and removes image files no note refers to (at least 32 characters).
# NOTEFEED_OPERATOR_TOKEN=

# Encryption at rest (sqlite or postgres only): the main key, at least 32 characters (openssl rand -hex 32), not the same
# as NOTEFEED_SECRET and without a comma. Losing it loses the data. Unset: not encrypted. See docs/self-hosting/storage.md.
# NOTEFEED_ENCRYPTION_KEY=
# Former main keys, comma-separated, for the one start after changing the key or moving it to OpenBao.
# NOTEFEED_ENCRYPTION_OLD_KEYS=
# openbao: the main key is in OpenBao instead (NOTEFEED_ENCRYPTION_KEY then stays empty). Unset: the local key above.
# NOTEFEED_KMS=openbao
# NOTEFEED_OPENBAO_ADDR=https://bao.internal:8200
# NOTEFEED_OPENBAO_ROLE_ID=
# NOTEFEED_OPENBAO_SECRET_ID=
# NOTEFEED_OPENBAO_MOUNT=transit
# NOTEFEED_OPENBAO_KEY=notefeed

# Optional sign-in through an OpenID Connect provider: notes then carry the signed-in person's
# name as a sender. Private by default: notefeed stores nothing about a person unless ALL FOUR
# are set (it also needs PUBLIC_URL and NOTEFEED_SECRET). NOTEFEED_OIDC_ALLOW is comma-separated
# e-mail addresses, @domain entries, or *; empty refuses everyone. See docs/self-hosting/sign-in/index.md.
# NOTEFEED_OIDC_ISSUER=https://authentik.example.com/application/o/notefeed/
# NOTEFEED_OIDC_CLIENT_ID=
# NOTEFEED_OIDC_CLIENT_SECRET=
# NOTEFEED_OIDC_ALLOW=@example.com
# Optional: id_token claims tried in order for the sender (default name,email). It is shown on notes and
# stored in the note file: sub is stable but opaque, email exposes an address.
# NOTEFEED_OIDC_SENDER_CLAIM=name,email
# Optional: the button text (default: the issuer's host).
# NOTEFEED_OIDC_LABEL=
# A second provider: any name of your choosing (WORK and GUESTS are only examples; nothing is predefined),
# with its own allow-list and sender claim. One redirect URI for all. See docs/self-hosting/sign-in/providers.md.
# NOTEFEED_OIDC_GUESTS_ISSUER=https://accounts.google.com
# NOTEFEED_OIDC_GUESTS_CLIENT_ID=
# NOTEFEED_OIDC_GUESTS_CLIENT_SECRET=
# NOTEFEED_OIDC_GUESTS_ALLOW=guest@example.org
# NOTEFEED_OIDC_GUESTS_LABEL=Guests
# Where sign-in keeps its accounts and sessions: a SQLite file of its own, apart from the notes, on every storage backend.
# Back it up next to the data. Default DATA_DIR/accounts.sqlite.
# NOTEFEED_ACCOUNTS_DB=/data/accounts.sqlite

# How much is logged (JSON lines on stdout): error, warn, info, debug or silent. Anything else counts as info.
# NOTEFEED_LOG_LEVEL=info

# 0 turns off the line logged for every request.
# NOTEFEED_LOG_REQUESTS=1

# 1 turns on GET /metrics (Prometheus). With a token it needs `Authorization: Bearer <token>`: set one unless the
# reverse proxy keeps /metrics private. See docs/self-hosting/operating.md.
# NOTEFEED_METRICS=0
# NOTEFEED_METRICS_TOKEN=

# Title of the RSS feed and the read-only view.
# NOTEFEED_TITLE=notefeed

# Time zone for times shown in the UI.
# TZ=UTC

# The user and group notefeed runs as, and so the owner of new note files (the Docker image only).
# Unset: the owner of the data folder.
# PUID=1000
# PGID=1000
